{
  "name": "ytsift",
  "version": "1.0.1",
  "description": "YouTube channel video filter userscript",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "ytsift.user.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node --watch-path=src scripts/build.mjs",
    "check": "biome check src/",
    "check:write": "biome check src/ --write",
    "lint:metadata": "eslint ytsift.user.js",
    "lint:metadata:write": "eslint ytsift.user.js --fix",
    "tsc": "tsc",
    "validate": "pnpm check && pnpm lint:metadata && pnpm tsc",
    "validate:write": "pnpm check:write && pnpm lint:metadata:write && pnpm tsc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-userscripts": "^0.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "src/**/*.js": [
      "biome check --write"
    ],
    "ytsift.user.js": [
      "eslint"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  }
}
